{
  "name": "ai-commit-message-gen",
  "displayName": "AI Commit Message Gen",
  "description": "Generate AI Git commit messages in VS Code using Conventional Commits. Supports OpenAI, Claude, Gemini, DeepSeek, and Mistral.",
  "version": "0.3.0",
  "publisher": "Nolomon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nolomon/Commit-Message-Gen-VS-X.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "git-commit",
    "commit-generator",
    "commit-message-generator",
    "ai-commit",
    "ai-commit-message",
    "ai",
    "source-control",
    "vscode-git",
    "claude",
    "openai",
    "gemini",
    "deepseek",
    "mistral",
    "conventional-commits"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitMessageGen.generate",
        "title": "AI: Generate Commit Message",
        "icon": {
          "light": "resources/light/sparkle.svg",
          "dark": "resources/dark/sparkle.svg"
        }
      },
      {
        "command": "commitMessageGen.setApiKey",
        "title": "AI Commit: Set API Key"
      },
      {
        "command": "commitMessageGen.clearApiKey",
        "title": "AI Commit: Clear API Key"
      },
      {
        "command": "commitMessageGen.setModel",
        "title": "AI Commit: Set Model"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitMessageGen.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Message Gen",
      "properties": {
        "commitMessageGen.model": {
          "type": "string",
          "enum": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5",
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gemini-3.7-flash",
            "gemini-3.1-flash-lite",
            "gemini-3.1-pro-preview",
            "deepseek-v4-flash",
            "deepseek-v4-pro",
            "mistral-medium-latest",
            "codestral-latest"
          ],
          "enumItemLabels": [
            "Claude — Opus 5",
            "Claude — Sonnet 5",
            "Claude — Haiku 4.5",
            "GPT — 5.6 Sol",
            "GPT — 5.6 Terra",
            "GPT — 5.6 Luna",
            "Gemini — 3.7 Flash",
            "Gemini — 3.1 Flash-Lite",
            "Gemini — 3.1 Pro (Preview)",
            "DeepSeek — V4 Flash",
            "DeepSeek — V4 Pro",
            "Mistral — Medium 3.5",
            "Mistral — Codestral"
          ],
          "markdownEnumDescriptions": [
            "_Anthropic_ · Claude Opus 5 — most capable Claude model",
            "_Anthropic_ · Claude Sonnet 5 — fast, balanced all-rounder",
            "_Anthropic_ · Claude Haiku 4.5 — lightweight and fast",
            "_OpenAI_ · GPT-5.6 Sol — flagship for complex work",
            "_OpenAI_ · GPT-5.6 Terra — balances intelligence and cost",
            "_OpenAI_ · GPT-5.6 Luna — fastest and most affordable",
            "_Google_ · Gemini 3.7 Flash — fast and versatile",
            "_Google_ · Gemini 3.1 Flash-Lite — cheapest and lowest latency",
            "_Google_ · Gemini 3.1 Pro — advanced reasoning. **Preview** — Google may retire it at short notice",
            "_DeepSeek_ · V4 Flash — fast general-purpose chat model",
            "_DeepSeek_ · V4 Pro — stronger reasoning, 3× the cost of Flash",
            "_Mistral_ · Medium 3.5 — flagship multimodal model",
            "_Mistral_ · Codestral — specialized for code"
          ],
          "default": "claude-sonnet-5",
          "description": "AI model to use for commit message generation. The provider is determined automatically from the selected model."
        },
        "commitMessageGen.focusMessageBox": {
          "type": "boolean",
          "default": false,
          "description": "Move the cursor into the commit message box once a message has been generated, and scroll a long message back to its first line. Off by default, so generation never interrupts what you are typing elsewhere — the trade-off is that a message taller than the box stays scrolled to its last line until you click into it. Turning this on takes focus whenever a message is ready, including mid-keystroke if you have moved on to something else."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
